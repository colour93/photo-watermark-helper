# CLI paths
WATERMARK_INPUT_DIR=./photos
WATERMARK_OUTPUT_DIR=./output

# Watermark defaults
WATERMARK_STYLE=minimal
WATERMARK_POSITION=auto
WATERMARK_TIME_FONT_PATH=
WATERMARK_LOCATION_FONT_PATH=
WATERMARK_OPACITY=0.88

# Reverse geocoding; empty means GPS coordinates are displayed
WATERMARK_AMAP_API_KEY=

# Optional server
WATERMARK_SERVER_HOST=127.0.0.1
WATERMARK_SERVER_PORT=9393
WATERMARK_API_TOKEN=
WATERMARK_DEBUG=false
