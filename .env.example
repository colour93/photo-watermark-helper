# CLI paths
WATERMARK_INPUT_DIR=./examples/input
WATERMARK_OUTPUT_DIR=./output

# Watermark defaults
WATERMARK_STYLE=minimal
WATERMARK_POSITION=auto
WATERMARK_TIME_FONT_PATH=
WATERMARK_LOCATION_FONT_PATH=
WATERMARK_TIME_FONT_SIZE_RATIO=0.035
WATERMARK_LOCATION_FONT_SIZE_RATIO=0.022
WATERMARK_MARGIN_RATIO=0.025
WATERMARK_PADDING_RATIO=0.012
WATERMARK_LINE_SPACING=1.25
WATERMARK_BLUR_RADIUS=14
WATERMARK_OPACITY=0.88

# Image output
WATERMARK_IMAGE_EXTS=.jpg,.jpeg,.png,.webp
WATERMARK_DEFAULT_JPEG_QUALITY=95
WATERMARK_DEFAULT_JPEG_SUBSAMPLING=0

# Reverse geocoding; leave empty to display GPS coordinates
WATERMARK_AMAP_API_KEY=

# Optional server (`uv sync --extra server`)
WATERMARK_SERVER_HOST=127.0.0.1
WATERMARK_SERVER_PORT=9393
WATERMARK_API_TOKEN=
WATERMARK_DEBUG=false
WATERMARK_LOG_LEVEL=INFO
WATERMARK_LOG_FILE=logs/watermarker.log
